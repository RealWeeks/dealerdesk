{
  "expo": {
    "name": "DealDesk",
    "slug": "dealdesk",
    "scheme": "dealdesk",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F1A",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "DealDesk",
      "themeColor": "#0B0F1A",
      "backgroundColor": "#0B0F1A"
    },
    "extra": {
      "router": {}
    }
  }
}
